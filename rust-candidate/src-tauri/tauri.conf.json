{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DemoStrike Rust Candidate",
  "version": "0.1.0",
  "identifier": "com.demostrike.candidate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DemoStrike Rust Candidate", "width": 1440, "height": 900, "minWidth": 880, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
